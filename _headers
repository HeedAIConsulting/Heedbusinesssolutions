# Cloudflare Pages headers configuration
# https://developers.cloudflare.com/pages/configuration/headers/

# ── Security headers (apply to all responses) ──
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self "https://elevenlabs.io" "https://*.elevenlabs.io"), camera=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# ── HTML — short cache, must revalidate (so users see updates fast) ──
/*.html
  Cache-Control: public, max-age=300, must-revalidate

/
  Cache-Control: public, max-age=300, must-revalidate

# ── CSS, JS, fonts — long cache (versioned via ?v=N query param) ──
/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# ── JSON data — medium cache (data changes occasionally) ──
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# ── Images — long cache ──
/images/*
  Cache-Control: public, max-age=31536000, immutable

# ── Downloadable checklists ──
/downloads/*
  Cache-Control: public, max-age=3600

# ── Sitemap + robots ──
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
