# ============================================================
#  West Valley Chamber — environment configuration
#  Copy this file to .env and fill in values to go live.
#  Without these, the site still runs — AI uses smart mock,
#  payments are stubs.
# ============================================================

# Anthropic Claude — powers the AI Concierge & Staff Assistant
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Square — payments (membership, tickets, sponsorships, donations)
# Production: https://developer.squareup.com/apps
# Sandbox is fine for demo.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox

# Optional — port override (defaults to 5500)
# PORT=5500
