# Firecrawl — web scraping and search (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-your-key-here

# Anthropic — Claude AI analysis (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Prospect Finder — simple password gate for internal tool
PROSPECT_TOOL_PASSWORD=your-secure-password

# Email notifications — where score reports are sent
NOTIFICATION_EMAIL=reachus@heedbusinesssolutions.com

# SMTP — for sending email via Nodemailer
# Gmail example: host=smtp.gmail.com, port=587, user=you@gmail.com, pass=app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# CORS — frontend domain allowed to call the API
ALLOWED_ORIGIN=https://heedbusinesssolutions.com
